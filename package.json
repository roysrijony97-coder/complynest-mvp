{
  "name": "complynest-monorepo",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "setup:all": "npm run frontend:install && npm run backend:install",
    "dev:all": "concurrently \"npm run backend:dev\" \"npm run frontend:dev\"",
    "frontend:install": "npm install --prefix frontend",
    "frontend:dev": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "frontend:preview": "npm run preview --prefix frontend",
    "backend:dev": "backend\\.venv\\Scripts\\python -m uvicorn backend.app.main:app --reload",
    "backend:install": "backend\\.venv\\Scripts\\python -m pip install -r backend/requirements.txt"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}